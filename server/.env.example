# ==============================================================================
# LearnHub AI — Backend Environment Configuration Example
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# CORS: Frontend Origins Allowed to Connect to this Backend
# Multiple origins can be comma-separated without trailing slashes.
# Example: https://your-frontend.vercel.app,http://localhost:5173
CLIENT_URL=https://your-frontend.vercel.app,http://localhost:5173

# Database Connection (MongoDB Atlas in Production)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/learnhub_ai?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/learnhub_ai?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_access_secret_key_here_min_256_bits
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_min_256_bits
JWT_REFRESH_EXPIRES_IN=7d

# Groq AI Dual-Model Architecture
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
AI_PROMPT_VERSION=v1.0

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service (SMTP)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_smtp_username
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM=no-reply@learnhub.ai

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
