# Server Configuration
PORT=5000
NODE_ENV=production

# Frontend Client URL(s) for CORS & Cookies (comma-separated if multiple, e.g. local + Vercel)
# Example: https://your-frontend.vercel.app,http://localhost:5173
CLIENT_URL=https://your-frontend.vercel.app

# Database (Use MongoDB Atlas connection string in production)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/learnhub_ai?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/learnhub_ai?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_access_secret_key_here_min_256_bits
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_min_256_bits
JWT_REFRESH_EXPIRES_IN=7d

# Groq AI Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
AI_PROMPT_VERSION=v1.0

# Cloudinary Storage (Optional for media uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service (SMTP)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_smtp_username
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM=no-reply@learnhub.ai

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
